-- Concert Rankings Database Schema: multi-table SQL project for tracking concerts and personal rankings/reviews of them
-- Drop tables if they exist already
DROP TABLE IF EXISTS setlists; 
DROP TABLE IF EXISTS rankings;
DROP TABLE IF EXISTS concerts;
DROP TABLE IF EXISTS venues;
DROP TABLE IF EXISTS artists;
DROP TABLE IF EXISTS users;

-- ARTISTS
CREATE TABLE artists (
    artist_id     SERIAL PRIMARY KEY,       
    name          VARCHAR(150) NOT NULL,
    genre         VARCHAR(100),
    formed_year   INTEGER,
    country       VARCHAR(100)
);

-- VENUES
CREATE TABLE venues (
    venue_id      SERIAL PRIMARY KEY,
    name          VARCHAR(150) NOT NULL,
    city          VARCHAR(100),
    country       VARCHAR(100),
    capacity      INTEGER
);

-- USERS  
CREATE TABLE users (
    user_id       SERIAL PRIMARY KEY,
    username      VARCHAR(50) UNIQUE NOT NULL,
    join_date     DATE NOT NULL DEFAULT CURRENT_DATE
);

-- CONCERTS  (specific artist playing a specific venue on a date)
CREATE TABLE concerts (
    concert_id    SERIAL PRIMARY KEY,
    artist_id     INTEGER NOT NULL REFERENCES artists(artist_id),
    venue_id      INTEGER NOT NULL REFERENCES venues(venue_id),
    concert_date  DATE NOT NULL,
    tour_name     VARCHAR(150)
);

-- RANKINGS  (user's rating/review of a concert they attended)
CREATE TABLE rankings (
    ranking_id    SERIAL PRIMARY KEY,
    user_id       INTEGER NOT NULL REFERENCES users(user_id),
    concert_id    INTEGER NOT NULL REFERENCES concerts(concert_id),
    rating        INTEGER NOT NULL CHECK (rating BETWEEN 1 AND 10),
    review_text   TEXT,
    ranked_date   DATE NOT NULL DEFAULT CURRENT_DATE,
    UNIQUE (user_id, concert_id)   -- one ranking per user per concert
);

-- SETLISTS  (optional extra table only if tracked or can be lifted from setlist.fm)
CREATE TABLE setlists (
    setlist_id    SERIAL PRIMARY KEY,
    concert_id    INTEGER NOT NULL REFERENCES concerts(concert_id),
    song_name     VARCHAR(150) NOT NULL,
    set_position  INTEGER NOT NULL,
    is_encore     BOOLEAN DEFAULT FALSE
);

-- Helpful indexes for common lookups/joins
CREATE INDEX idx_concerts_artist ON concerts(artist_id);
CREATE INDEX idx_concerts_venue ON concerts(venue_id);
CREATE INDEX idx_rankings_concert ON rankings(concert_id);
CREATE INDEX idx_rankings_user ON rankings(user_id);
CREATE INDEX idx_setlists_concert ON setlists(concert_id);
